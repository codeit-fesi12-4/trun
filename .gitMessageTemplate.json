{
  "configVersion": "1",
  "staticTemplate": ["{emoji} {type} : {description}", "", "{body}"],
  "dynamicTemplate": ["{emoji} {type}: {description}", "{body}"],
  "tokens": [
    {
      "label": "Type",
      "name": "type",
      "type": "enum",
      "options": [
        { "label": "Feat - 새로운 기능 추가", "value": "Feat" },
        { "label": "Fix - 버그 수정", "value": "Fix" },
        { "label": "Docs - 문서 수정", "value": "Docs" },
        {
          "label": "Style - 코드 formatting, 세미콜론 누락, 코드 자체의 변경이 없는 경우",
          "value": "Style"
        },
        {
          "label": "Refactor - 코드 리팩토링 (성능 및 코드 로직 개선)",
          "value": "Refactor"
        },
        {
          "label": "Test - 테스트 코드, 리팩토링 테스트 코드 추가",
          "value": "Test"
        },
        {
          "label": "Chore - 패키지 매니저 수정, 그 외 기타 수정 ex. .gitignore",
          "value": "Chore"
        },
        { "label": "Design - CSS 등 사용자 UI 디자인 변경", "value": "Design" },
        { "label": "Comment - 필요한 주석 추가 및 변경", "value": "Comment" },
        {
          "label": "Rename - 파일 또는 폴더 명을 수정하거나 옮기는 작업만인 경우",
          "value": "Rename"
        },
        { "label": "Remove - 파일을 삭제한 경우", "value": "Remove" },
        {
          "label": "!HOTFIX - 급하게 치명적인 버그를 고쳐야 하는 경우",
          "value": "!HOTFIX"
        }
      ]
    },

    {
      "label": "Emoji",
      "name": "emoji",
      "type": "enum",
      "options": [
        { "label": "✨Feat", "value": "✨" },
        { "label": "🐛Fix", "value": "🐛" },
        { "label": "📝Docs", "value": "📝" },
        { "label": "🎨Style", "value": "🎨" },
        { "label": "♻️Refactor", "value": "♻️" },
        { "label": "🔧Chore", "value": "🔧" },
        { "label": "🧪Test", "value": "🧪" },
        { "label": "💄Design", "value": "💄" },
        { "label": "💡Comment", "value": "💡" },
        { "label": "🚚Rename", "value": "🚚" },
        { "label": "🗑️Remove", "value": "🗑️" },
        { "label": "🚑!HOTFIX", "value": "🚑" }
      ]
    },
    {
      "label": "Description",
      "name": "description",
      "type": "text",
      "description": "커밋에 대한 짧은 설명"
    },
    {
      "label": "Body",
      "name": "body",
      "type": "text",
      "description": "상세 설명 (선택)",
      "multiline": true
    }
  ]
}
